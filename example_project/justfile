set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

export UV_CACHE_DIR := "../.cache/testing-example-uv"
export RUFF_CACHE_DIR := "../.cache/testing-example-ruff"
export PYTHONPATH := "src"

default:
    @just --list

# Regenerate command and marker documentation from executable sources.
docs-generate:
    uv run python -m scripts.docs_reference --write

# Check generated references, stale paths, and text encoding.
docs-check:
    uv run python -m scripts.docs_reference

# Resolve the current testing-policy obligations without changing state.
policy-plan decision="merge":
    uv run testpolicy plan --decision {{quote(decision)}}

# Show the current testing-policy state.
policy-status decision="merge":
    uv run testpolicy status --decision {{quote(decision)}}

# Fail when a blocking policy obligation is unresolved.
policy-gate decision="merge":
    uv run testpolicy gate --decision {{quote(decision)}}

# Show human reviews, waivers, and exceptions needing attention.
policy-review decision="release":
    uv run testpolicy review --decision {{quote(decision)}}

# Validate policy configuration and durable records.
policy-validate:
    uv run testpolicy validate

# Create or update the locked development environment.
setup:
    uv sync

# Run the complete trusted selection and write version-5 evidence.
test:
    uv run python -m scripts.run_tests

# Run a partial selection that excludes slow and quarantined tests.
test-fast:
    uv run python -m scripts.run_tests --fast

# Run a partial marker expression (usage: just test-marker "unit and regression").
test-marker expression:
    uv run python -m scripts.run_tests --marker {{quote(expression)}}

# Run quarantined tests diagnostically; never use this as trusted evidence.
test-quarantined:
    uv run python -m scripts.run_tests --quarantined

# Check source, tests, and operational scripts.
lint:
    uv run ruff check .

# Format source, tests, and operational scripts.
format:
    uv run ruff format .

# Verify formatting without changing files.
format-check:
    uv run ruff format --check .

# Run the ordinary local hard gate.
check: lint format-check docs-check policy-validate test
    uv run testpolicy gate --decision merge

# Assess flakes only across comparable complete trusted runs.
health: test
    uv run python -m scripts.test_evidence health .cache/evidence/full.json .cache/test-history

# Export this environment's compatibility cell.
compatibility: test
    uv run python -m scripts.test_evidence compatibility .cache/evidence/full.json .cache/compatibility

# Build the source distribution and wheel.
build:
    uv build

# Build, install, and execute the wheel outside the source tree.
test-wheel: build
    uv run python -m scripts.test_wheel

# Measure the packaged command against the project-owned specification.
performance:
    uv run python -m scripts.performance_check

# Aggregate all release obligations; compatibility evidence must cover the matrix.
release-check evidence=".cache/compatibility":
    uv run python -m scripts.release_check --compatibility-evidence {{quote(evidence)}}
